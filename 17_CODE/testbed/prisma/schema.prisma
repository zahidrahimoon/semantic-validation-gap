// Prisma 7 schema for the testbed. SQLite, single file. The DATABASE constraints
// here are the last structural layer (types, required, unique, relations).
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String    @id @default(cuid())
  displayName String
  username    String    @unique
  bio         String    @default("")
  birthDate   String // YYYY-MM-DD
  website     String    @default("")
  country     String
  isAdmin     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
  reviews     Review[]
  tickets     Ticket[]
}

model Course {
  id              String    @id @default(cuid())
  title           String
  description     String
  category        String
  level           String
  location        String
  price           Int
  discountPercent Int       @default(0)
  capacity        Int
  startsAt        DateTime
  endsAt          DateTime
  tags            String    @default("") // comma-separated (kept simple)
  createdAt       DateTime  @default(now())
  bookings        Booking[]
  reviews         Review[]
}

model PromoCode {
  code            String   @id
  discountPercent Int
  appliesTo       String   @default("ANY") // course category or ANY
  expiresAt       DateTime
}

model Booking {
  id            String   @id @default(cuid())
  ref           String   @unique // BK-000000
  userId        String
  courseId      String
  seats         Int
  attendeeName  String
  attendeeEmail String
  promoCode     String   @default("")
  notes         String   @default("")
  totalPrice    Int
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  course        Course   @relation(fields: [courseId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

model Ticket {
  id                String   @id @default(cuid())
  userId            String
  subject           String
  description       String
  priority          String
  category          String
  bookingRef        String   @default("")
  // filled by the AI triage (Ollama)
  aiSummary         String   @default("")
  aiCategory        String   @default("")
  aiPriority        String   @default("")
  aiDraftReply      String   @default("")
  aiModel           String   @default("")
  aiMs              Int      @default(0)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  model     String   @default("")
  ms        Int      @default(0)
  createdAt DateTime @default(now())
}
